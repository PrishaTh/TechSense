# Local dev: copy to .dev.vars (gitignored) -- `wrangler dev` reads that file.
# Deployed: set these as Worker secrets/vars. Never commit real values.

# Google AI Studio key, used when no Anthropic key is set.
GEMINI_API_KEY=

# Anthropic key. When present it takes priority over GEMINI_API_KEY.
ANTHROPIC_API_KEY=

# Set to false to hide the chat button and disable /api/chatbot entirely.
CHATBOT_ENABLED=true

# Optional model override.
# Gemini default: gemini-3.5-flash. Anthropic default: claude-sonnet-5-5.
CHATBOT_MODEL=
